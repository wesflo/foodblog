        "@storybook/react-vite": "10.4.2",
        "@storybook/test": "^8.6.15",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3",
        "jsdom": "^29.1.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "storybook": "10.4.2",
