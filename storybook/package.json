{
    "name": "@wesflo/ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./icons": "./src/icons.ts",
        "./styles": "./src/styles/globals.css"
    },
    "scripts": {
        "storybook": "storybook dev -p 6006",
        "dev": "pnpm run storybook",
