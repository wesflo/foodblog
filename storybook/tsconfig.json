{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "incremental": true,
        "jsx": "react-jsx",
        "paths": {
            "@wesflo/ui": ["./src/index.ts"],
            "@wesflo/ui/styles": ["./src/styles/globals.css"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", ".storybook/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "storybook-static"]
}
