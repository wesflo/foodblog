{
    "name": "@wesflo/foodblog-workspace",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "turbo run dev --parallel",
        "dev:studio": "pnpm --filter @wesflo/foodblog-studio dev",
        "dev:ui": "pnpm --filter @wesflo/foodblog-ui dev",
        "dev:server": "pnpm --filter @wesflo/foodblog-server dev",
        "build": "turbo run build",
        "build:studio": "pnpm --filter @wesflo/foodblog-studio build",
        "build:ui": "pnpm --filter @wesflo/foodblog-ui build",
        "build:server": "pnpm --filter @wesflo/foodblog-server build",
        "deploy:studio": "pnpm --filter @wesflo/foodblog-studio deploy",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:watch": "turbo run test:watch",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "turbo run clean && find . -name .turbo -type d -prune -exec rm -rf {} + && rm -rf .turbo coverage .pnpm-store"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.2.7",
        "@types/node": "25.9.1",
        "eslint": "10.4.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.6.0",
        "prettier": "3.8.3",
        "turbo": "2.9.16",
        "typescript": "5.9.3",
        "typescript-eslint": "8.60.1"
    }
}
