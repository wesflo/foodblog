{
    "name": "@wesflo/foodblog-workspace",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "dev:cms": "turbo dev --filter=@wesflo/foodblog-cms",
        "dev:ui": "turbo dev --filter=@wesflo/foodblog-ui",
        "dev:api": "turbo dev --filter=@wesflo/foodblog-api",
        "build": "turbo build",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "typecheck": "turbo typecheck",
        "test": "turbo test",
        "test:watch": "turbo test:watch --parallel",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "clean": "turbo clean && find . -name .turbo -type d -prune -exec rm -rf {} + && rm -rf .turbo coverage .pnpm-store"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.2.7",
        "@types/node": "25.9.1",
        "eslint": "10.4.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.6.0",
        "prettier": "3.8.3",
        "turbo": "2.9.16",
        "typescript": "5.9.3",
        "typescript-eslint": "8.60.1"
    }
}
