{
    "name": "@wesflo/foodblog-server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist coverage tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "fastify": "5.8.5",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "tsx": "4.22.4",
        "vitest": "4.1.8"
    }
}
